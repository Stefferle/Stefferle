<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{7E4B2F91-3A5C-4D8E-B2F6-1A9C3E7D5B8A}</ProjectGuid>
        <ProjectVersion>20.3</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <MainSource>ExcelImport.dpr</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Base</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>1</TargetedPlatforms>
        <AppType>Application</AppType>
        <ProjectName Condition="'$(ProjectName)'==''">ExcelImport</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>ExcelImport</SanitizedProjectName>
    </PropertyGroup>
    <!-- Search paths et packages — hérités par Debug et Release -->
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <BT_BuildType>Debug</BT_BuildType>
        <DCC_UnitSearchPath>Core;Importers;Forms;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_UsePackage>vcl;rtl;vclimg;vclwinx;FireDAC;adortl;dbrtl;$(DCC_UsePackage)</DCC_UsePackage>
        <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;$(DCC_Namespace)</DCC_Namespace>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <DCCReference Include="Forms\MainForm.pas">
            <Form>FormMain</Form>
        </DCCReference>
        <DCCReference Include="Core\ImportTypes.pas"/>
        <DCCReference Include="Core\ImportLog.pas"/>
        <DCCReference Include="Core\ImportContext.pas"/>
        <DCCReference Include="Core\ExcelReader.pas"/>
        <DCCReference Include="Core\DbHelpers.pas"/>
        <DCCReference Include="Core\BaseImporter.pas"/>
        <DCCReference Include="Importers\ImportOrchestrator.pas"/>
        <DCCReference Include="Importers\ImportEngagements.pas"/>
    </ItemGroup>
    <ProjectExtensions>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">ExcelImport.dpr</Source>
                </Source>
                <Excluded_Packages/>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
        <Borland.Personality/>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\Studio\$(ProductVersion)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\Studio\$(ProductVersion)\UserTools.proj')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
